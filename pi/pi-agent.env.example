# Install as /etc/my-podcast-private/pi-agent.env (root:root, chmod 600).
# Never commit a populated copy.
PODCAST_WORKER_URL=https://YOUR-WORKER.workers.dev
PI_AGENT_TOKEN=REPLACE_WITH_INDEPENDENT_RANDOM_32_BYTE_TOKEN
R2_ACCOUNT_ID=REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID
R2_ACCESS_KEY_ID=REPLACE_WITH_R2_BUCKET_SCOPED_KEY
R2_SECRET_ACCESS_KEY=REPLACE_WITH_R2_SECRET_KEY
R2_BUCKET=my-podcast-private-audio
POLL_INTERVAL_SECONDS=60
MAX_DOWNLOAD_MB=300
YTDLP_JS_RUNTIME=deno
# Alternative: node, or node:/usr/local/bin/node (Node >=22).
# Optional:
# YTDLP_BINARY=/opt/my-podcast-private/.venv/bin/yt-dlp
