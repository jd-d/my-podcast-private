[Unit]
Description=Private podcast audio importer (yt-dlp + R2)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=podcast
Group=podcast
WorkingDirectory=/opt/my-podcast-private
EnvironmentFile=/etc/my-podcast-private/pi-agent.env
Environment=HOME=/tmp
Environment=XDG_CACHE_HOME=/tmp/my-podcast-cache
Environment=DENO_DIR=/tmp/my-podcast-deno
Environment=PYTHONDONTWRITEBYTECODE=1
StateDirectory=my-podcast-private
ExecStart=/opt/my-podcast-private/.venv/bin/python /opt/my-podcast-private/pi/worker.py
Restart=always
RestartSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/tmp /var/lib/my-podcast-private
MemoryMax=750M
CPUQuota=90%
UMask=0077

[Install]
WantedBy=multi-user.target
