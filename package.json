{
  "name": "my-podcast-private",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "cf:types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "typecheck": "tsc --noEmit",
    "lint:md": "markdownlint \"**/*.md\"",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run --exclude integration/**",
    "test:integration": "node --test integration/runtime.test.mjs",
    "test:watch": "vitest",
    "recipient:token": "node --env-file=.dev.vars scripts/generate-recipient.mjs",
    "telegram:webhook": "node --env-file=.dev.vars scripts/set-telegram-webhook.mjs"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "overrides": {
    "markdownlint-cli": {
      "run-con": "1.3.2"
    }
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261028.1",
    "esbuild": "0.28.2",
    "markdownlint-cli": "0.47.0",
    "miniflare": "5.20261023.1-beta",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "wrangler": "4.154.0"
  }
}
