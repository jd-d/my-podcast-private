{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-podcast-private",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-07",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "PODCAST_TITLE": "Private audio",
    "PODCAST_DESCRIPTION": "Private audio feed",
    "PODCAST_AUTHOR": "Private",
    "DOWNLOAD_SESSION_MINUTES": "30"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "my-podcast-private-db",
      "database_id": "REPLACE_AFTER_D1_CREATE",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "AUDIO",
      "bucket_name": "my-podcast-private-audio"
    }
  ],
  "triggers": {
    "crons": ["17 3 * * *"]
  }
}
